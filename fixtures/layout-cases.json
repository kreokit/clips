{
  "_comment": "Shared test cases for caption line layout. Both src-tauri/src/layout.rs and src/lib/captions/layout.ts must produce exactly these pages, so the preview and the exports break lines the same way. Each page lists its lines as word texts. Breaking rules: see layout.rs.",
  "cases": [
    {
      "name": "fits on one line",
      "max_chars": 32,
      "max_lines": 2,
      "segment": {
        "start_ms": 1000,
        "end_ms": 2000,
        "text": "Hello there",
        "words": [
          {
            "start_ms": 1000,
            "end_ms": 1400,
            "text": "Hello"
          },
          {
            "start_ms": 1400,
            "end_ms": 2000,
            "text": "there"
          }
        ]
      },
      "pages": [
        {
          "start_ms": 1000,
          "end_ms": 2000,
          "lines": [
            [
              "Hello",
              "there"
            ]
          ]
        }
      ]
    },
    {
      "name": "a line holds exactly max_chars, including spaces",
      "max_chars": 11,
      "max_lines": 2,
      "segment": {
        "start_ms": 0,
        "end_ms": 3000,
        "text": "Hello there friend",
        "words": [
          {
            "start_ms": 0,
            "end_ms": 1000,
            "text": "Hello"
          },
          {
            "start_ms": 1000,
            "end_ms": 2000,
            "text": "there"
          },
          {
            "start_ms": 2000,
            "end_ms": 3000,
            "text": "friend"
          }
        ]
      },
      "pages": [
        {
          "start_ms": 0,
          "end_ms": 3000,
          "lines": [
            [
              "Hello",
              "there"
            ],
            [
              "friend"
            ]
          ]
        }
      ]
    },
    {
      "name": "overflows into a second page that starts with its first word",
      "max_chars": 10,
      "max_lines": 2,
      "segment": {
        "start_ms": 500,
        "end_ms": 6000,
        "text": "The quick brown fox jumps over the lazy dog",
        "words": [
          {
            "start_ms": 600,
            "end_ms": 800,
            "text": "The"
          },
          {
            "start_ms": 800,
            "end_ms": 1200,
            "text": "quick"
          },
          {
            "start_ms": 1200,
            "end_ms": 1600,
            "text": "brown"
          },
          {
            "start_ms": 1600,
            "end_ms": 2000,
            "text": "fox"
          },
          {
            "start_ms": 2000,
            "end_ms": 2500,
            "text": "jumps"
          },
          {
            "start_ms": 2500,
            "end_ms": 3000,
            "text": "over"
          },
          {
            "start_ms": 3000,
            "end_ms": 3200,
            "text": "the"
          },
          {
            "start_ms": 3200,
            "end_ms": 3700,
            "text": "lazy"
          },
          {
            "start_ms": 3700,
            "end_ms": 4200,
            "text": "dog"
          }
        ]
      },
      "pages": [
        {
          "start_ms": 500,
          "end_ms": 2000,
          "lines": [
            [
              "The",
              "quick"
            ],
            [
              "brown",
              "fox"
            ]
          ]
        },
        {
          "start_ms": 2000,
          "end_ms": 3700,
          "lines": [
            [
              "jumps",
              "over"
            ],
            [
              "the",
              "lazy"
            ]
          ]
        },
        {
          "start_ms": 3700,
          "end_ms": 6000,
          "lines": [
            [
              "dog"
            ]
          ]
        }
      ]
    },
    {
      "name": "a word longer than max_chars gets its own line",
