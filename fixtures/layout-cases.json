    {
      "name": "a new sentence's first word moves to the next line (not \"RICH. I / DON'T\")",
      "max_chars": 14,
      "max_lines": 2,
      "segment": {
        "start_ms": 0,
        "end_ms": 1800,
        "text": "He got rich. I don't know",
        "words": [
          {
            "start_ms": 0,
            "end_ms": 300,
            "text": "He"
          },
          {
            "start_ms": 300,
            "end_ms": 600,
            "text": "got"
          },
          {
            "start_ms": 600,
            "end_ms": 900,
            "text": "rich."
          },
          {
            "start_ms": 900,
            "end_ms": 1200,
            "text": "I"
          },
          {
            "start_ms": 1200,
            "end_ms": 1500,
            "text": "don't"
          },
          {
            "start_ms": 1500,
            "end_ms": 1800,
            "text": "know"
          }
        ]
      },
      "pages": [
        {
          "start_ms": 0,
          "end_ms": 1800,
          "lines": [
            [
              "He",
              "got",
              "rich."
            ],
            [
              "I",
              "don't",
              "know"
            ]
          ]
        }
      ]
    },
    {
